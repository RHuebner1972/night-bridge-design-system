---
interface Props {
  title?: string;
  compact?: boolean;
  class?: string;
}

const { title, compact = false, class: className = "" } = Astro.props;

const classes = [
  "ds-card",
  compact ? "ds-card--compact" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  {title && <p class="ds-card__title">{title}</p>}
  <div class="ds-card__body">
    <slot />
  </div>
</div>

<style>
  .ds-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: inset 0 1px 0 color-mix(in oklch, var(--color-ink) 6%, transparent);
  }

  .ds-card--compact {
    padding: var(--space-md);
  }

  .ds-card__title {
    font-family: var(--font-display);
    font-size: var(--text-subheading);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm) 0;
    max-width: none;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
  }

  .ds-card__body {
    color: var(--color-ink-soft);
    font-size: var(--text-secondary);
  }
</style>
