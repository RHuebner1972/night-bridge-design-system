---
---

<div class="viz-hero" role="img" aria-label="Stylized route chart with warm and cool accent lines on a dark grid">
  <div class="viz-hero__panel">
    <div class="viz-hero__toolbar">
      <span class="viz-hero__dot viz-hero__dot--accent"></span>
      <span class="viz-hero__dot viz-hero__dot--warm"></span>
      <span class="viz-hero__dot viz-hero__dot--muted"></span>
      <span class="viz-hero__label type-caption">Route · North Atlantic</span>
    </div>
    <svg class="viz-hero__svg" viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="vizBg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="oklch(0.24 0.05 248)" />
          <stop offset="100%" stop-color="oklch(0.18 0.04 250)" />
        </linearGradient>
        <linearGradient id="routeWarm" x1="0" y1="0" x2="1" y2="0">
          <stop stop-color="oklch(0.72 0.12 70)" />
          <stop offset="1" stop-color="oklch(0.68 0.11 185)" />
        </linearGradient>
      </defs>
      <rect width="400" height="220" fill="url(#vizBg)" rx="8"/>
      <g stroke="oklch(0.32 0.03 250)" stroke-width="0.5" opacity="0.8">
        <path d="M0 44 H400 M0 88 H400 M0 132 H400 M0 176 H400"/>
        <path d="M50 0 V220 M150 0 V220 M250 0 V220 M350 0 V220"/>
      </g>
      <path
        d="M40 160 C80 120, 120 140, 160 100 S240 60, 280 80 S340 40, 360 56"
        fill="none"
        stroke="url(#routeWarm)"
        stroke-width="2.5"
        stroke-linecap="round"
      />
      <path
        d="M40 160 C80 120, 120 140, 160 100 S240 60, 280 80"
        fill="none"
        stroke="oklch(0.68 0.11 185 / 0.45)"
        stroke-width="8"
        stroke-linecap="round"
      />
      <circle cx="40" cy="160" r="4" fill="oklch(0.72 0.12 70)"/>
      <circle cx="160" cy="100" r="3" fill="oklch(0.68 0.11 185)"/>
      <circle cx="360" cy="56" r="4" fill="oklch(0.72 0.12 70)"/>
      <text x="24" y="28" fill="oklch(0.65 0.03 250)" font-family="system-ui,sans-serif" font-size="10" letter-spacing="0.08em">ALT · 12,400 ft</text>
      <text x="280" y="28" fill="oklch(0.65 0.03 250)" font-family="system-ui,sans-serif" font-size="10">ETA 04:18</text>
    </svg>
  </div>
</div>

<style>
  .viz-hero {
    width: 100%;
    max-width: 28rem;
  }

  .viz-hero__panel {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--color-accent) 8%, transparent),
      0 24px 48px color-mix(in oklch, var(--color-bg) 60%, transparent);
  }

  .viz-hero__toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-surface-raised);
  }

  .viz-hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
  }

  .viz-hero__dot--accent {
    background-color: var(--color-accent);
  }

  .viz-hero__dot--warm {
    background-color: var(--color-primary);
  }

  .viz-hero__dot--muted {
    background-color: var(--color-muted);
    opacity: 0.5;
  }

  .viz-hero__label {
    margin-left: auto;
    color: var(--color-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .viz-hero__svg {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }
</style>
