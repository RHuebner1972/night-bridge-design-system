---
const navItems = [
  { href: "#colors", label: "Tokens" },
  { href: "#type", label: "Type" },
  { href: "#components", label: "Components" },
  { href: "#agents", label: "Agents" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="#overview">
      <span class="site-header__mark" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="2" width="24" height="24" rx="6" stroke="currentColor" stroke-width="1.5" opacity="0.35"/>
          <path d="M6 18 L14 10 L22 14 L26 12" stroke="url(#markGrad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="14" cy="10" r="2" fill="var(--color-accent)"/>
          <defs>
            <linearGradient id="markGrad" x1="6" y1="18" x2="22" y2="10" gradientUnits="userSpaceOnUse">
              <stop stop-color="var(--color-accent)"/>
              <stop offset="1" stop-color="var(--color-primary)"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="site-header__wordmark">
        <span class="site-header__title">Night Bridge</span>
      </span>
    </a>

    <nav class="site-header__nav site-header__nav--desktop" aria-label="Primary">
      <ul class="site-header__nav-list">
        {navItems.map((item) => (
          <li>
            <a
              class="site-header__nav-link"
              href={item.href}
              data-section-nav={item.href.slice(1)}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <nav class="site-header__jump" aria-label="Jump to section">
    <ul class="site-header__jump-list">
      {navItems.map((item) => (
        <li class="site-header__jump-item">
          <a
            class="site-header__jump-link"
            href={item.href}
            data-section-nav={item.href.slice(1)}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="site-header__glow" aria-hidden="true"></div>
</header>

<script>
  const sectionIds = ["overview", "colors", "type", "components", "agents"];

  function setActiveSection(id) {
    document.querySelectorAll("[data-section-nav]").forEach((link) => {
      const el = link;
      const match = el.dataset.sectionNav === id;
      el.classList.toggle("is-active", match);
      if (match) {
        el.setAttribute("aria-current", "location");
        if (el.classList.contains("site-header__jump-link")) {
          el.scrollIntoView({
            inline: "nearest",
            block: "nearest",
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth",
          });
        }
      } else {
        el.removeAttribute("aria-current");
      }
    });
  }

  function initSectionNav() {
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el) => Boolean(el));

    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible[0]?.target.id) {
          setActiveSection(visible[0].target.id);
        }
      },
      {
        rootMargin: "-20% 0px -55% 0px",
        threshold: [0, 0.15, 0.35, 0.5],
      },
    );

    sections.forEach((section) => observer.observe(section));

    window.addEventListener("hashchange", () => {
      const hash = window.location.hash.replace("#", "");
      if (sectionIds.includes(hash)) {
        setActiveSection(hash);
      }
    });

    const hash = window.location.hash.replace("#", "");
    if (hash && sectionIds.includes(hash)) {
      setActiveSection(hash);
    }
  }

  initSectionNav();
  document.addEventListener("astro:page-load", initSectionNav);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: color-mix(in oklch, var(--color-surface) 92%, transparent);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(8px);
  }

  .site-header__glow {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklch, var(--color-accent) 60%, transparent),
      color-mix(in oklch, var(--color-primary) 50%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-lg);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
    min-width: 0;
    flex-shrink: 0;
  }

  .site-header__brand:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .site-header__brand:hover {
    color: inherit;
  }

  .site-header__mark {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .site-header__wordmark {
    min-width: 0;
  }

  .site-header__title {
    font-family: var(--font-display);
    font-size: var(--text-secondary);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink-strong);
    line-height: 1.2;
  }

  .site-header__nav--desktop {
    flex: 1;
    display: none;
    justify-content: center;
    min-width: 0;
  }

  @media (min-width: 52rem) {
    .site-header__nav--desktop {
      display: flex;
    }
  }

  .site-header__nav-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav-link,
  .site-header__jump-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    transition:
      color var(--duration-normal) var(--ease-out-quart),
      border-color var(--duration-normal) var(--ease-out-quart),
      background-color var(--duration-normal) var(--ease-out-quart);
  }

  .site-header__nav-link {
    padding: var(--space-xs) var(--space-sm);
    min-height: 2.75rem;
  }

  .site-header__nav-link:hover,
  .site-header__jump-link:hover {
    color: var(--color-ink-strong);
    background-color: var(--color-surface-raised);
    border-color: var(--color-line);
  }

  .site-header__nav-link:focus-visible,
  .site-header__jump-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .site-header__nav-link.is-active,
  .site-header__jump-link.is-active {
    color: var(--color-ink-strong);
    background-color: color-mix(in oklch, var(--color-accent) 14%, var(--color-surface));
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-line));
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .site-header__jump {
    display: block;
    border-top: 1px solid color-mix(in oklch, var(--color-line) 80%, transparent);
    background-color: color-mix(in oklch, var(--color-surface) 88%, transparent);
  }

  @media (min-width: 52rem) {
    .site-header__jump {
      display: none;
    }
  }

  .site-header__jump-list {
    display: flex;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: var(--space-sm) var(--space-lg);
    max-width: 72rem;
    margin-inline: auto;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .site-header__jump-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .site-header__jump-link {
    padding: var(--space-sm) var(--space-md);
    min-height: 2.75rem;
    min-width: 2.75rem;
    white-space: nowrap;
  }
</style>
