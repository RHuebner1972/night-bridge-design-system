---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/shell/SiteHeader.astro";
import SiteFooter from "../components/shell/SiteFooter.astro";
import RouteViz from "../components/shell/RouteViz.astro";
import Button from "../components/ds/Button.astro";
import Card from "../components/ds/Card.astro";
import Badge from "../components/ds/Badge.astro";
import Input from "../components/ds/Input.astro";
import ColorSwatch from "../components/ds/ColorSwatch.astro";
import Section from "../components/ds/Section.astro";

const swatches = [
  { name: "Abyss background", token: "--color-bg" },
  { name: "Panel surface", token: "--color-surface" },
  { name: "Ink", token: "--color-ink" },
  { name: "Muted", token: "--color-muted" },
  { name: "Warm primary", token: "--color-primary" },
  { name: "Cool accent", token: "--color-accent" },
  { name: "Instrument focus", token: "--color-focus" },
];

const typeRows = [
  { label: "Display", cls: "type-display", sample: "Chart your course" },
  { label: "Heading", cls: "type-heading", sample: "Quiet bridge, clear panels" },
  { label: "Body", cls: "type-body", sample: "Welcome aboard. Your route is synced and the night sea is calm." },
  { label: "Secondary", cls: "type-secondary", sample: "Secondary copy stays readable without shouting." },
  { label: "Caption", cls: "type-caption", sample: "Metadata · labels" },
];
---

<BaseLayout title="Night Bridge · Design System" description="Dark Boutique Bridge — calm exploration UI with warm-earth and cool-teal accents.">

  <SiteHeader />

  <main class="page-main" id="main-content">

    <section class="hero" id="overview">
      <div class="hero__grid">
        <div class="hero__copy">
          <h1 class="type-display hero__headline">
            Calm depth.<br />Warm instruments.
          </h1>
          <p class="hero__lede type-secondary">
            Edit <span class="inline-code">src/styles/global.css</span> — sections below reskin instantly.
          </p>
        </div>
        <RouteViz />
      </div>
    </section>

    <div class="content-wrap">

      <Section id="colors" heading="Color tokens">
        <div class="swatch-grid">
          {swatches.map((s) => (
            <ColorSwatch name={s.name} token={s.token} />
          ))}
        </div>
      </Section>

      <Section id="type" heading="Type scale">
        <div class="type-panel">
          {typeRows.map((row) => (
            <div class="type-row">
              <span class="type-row__label type-caption text-muted">{row.label}</span>
              <span class={`type-row__sample font-display ${row.cls}`}>{row.sample}</span>
            </div>
          ))}
        </div>
      </Section>

      <Section id="components" heading="Components">
        <div class="component-lanes">

          <div class="lane">
            <p class="lane__heading">Actions</p>
            <div class="lane__items">
              <Button variant="primary">Primary</Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="ghost">Ghost</Button>
            </div>
          </div>

          <div class="lane">
            <p class="lane__heading">Status</p>
            <div class="lane__items lane__items--wrap">
              <Badge tone="ocean">Underway</Badge>
              <Badge tone="gold">Priority</Badge>
            </div>
          </div>

          <div class="lane">
            <p class="lane__heading">Forms</p>
            <div class="lane__items lane__items--col">
              <Input
                id="demo-name"
                label="Guest name"
                type="text"
                placeholder="Alex Rivera"
              />
              <Input
                id="demo-email"
                label="Contact email"
                type="email"
                placeholder="alex@example.com"
                error="Example error — not live validation."
                errorSpecimen
              />
            </div>
          </div>

          <div class="lane">
            <p class="lane__heading">Surfaces</p>
            <div class="lane__items lane__items--col">
              <Card title="Panel card">
                Raised surface on <span class="inline-code">--color-surface</span>.
              </Card>
            </div>
          </div>

        </div>
      </Section>

      <Section id="agents" heading="For agents">
        <p class="type-caption agent-example text-muted">
          Product example: <a href="/coaching">Harbor Chapter</a>
        </p>
        <nav class="agent-panel" aria-label="Agent endpoints">
          <ul class="agent-links">
            <li><a href="/tokens.json"><code>/tokens.json</code></a></li>
            <li><a href="/system.md"><code>/system.md</code></a></li>
            <li><a href="/llms.txt"><code>/llms.txt</code></a></li>
          </ul>
        </nav>
      </Section>

    </div>
  </main>

  <SiteFooter />

</BaseLayout>

<style>
  .hero {
    padding: clamp(var(--space-2xl), 8vw, var(--space-3xl)) var(--space-lg)
      var(--space-2xl);
    border-bottom: 1px solid var(--color-line);
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--color-accent) 8%, transparent),
      transparent 45%
    );
    scroll-margin-top: 7.5rem;
  }

  .hero__grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .hero__grid {
      grid-template-columns: 1fr minmax(16rem, 28rem);
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero__headline {
    max-width: 14ch;
    color: var(--color-ink-strong);
  }

  .hero__lede {
    max-width: 42ch;
    color: var(--color-ink-soft);
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-md);
  }

  .type-panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .type-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: baseline;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-line);
  }

  .type-row:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  @media (max-width: 32rem) {
    .type-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }

  .type-row__label {
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .type-row__sample {
    color: var(--color-ink-strong);
  }

  .component-lanes {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 40rem) {
    .component-lanes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .component-lanes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl) var(--space-xl);
    }
  }

  .lane__heading {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-muted);
    margin: 0 0 var(--space-sm) 0;
    max-width: none;
  }

  .lane__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .lane__items--col {
    flex-direction: column;
    width: 100%;
    max-width: none;
  }

  @media (min-width: 40rem) {
    .lane__items--col {
      max-width: 24rem;
    }
  }

  .agent-panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    max-width: 28rem;
    margin-top: var(--space-sm);
  }

  .agent-example {
    margin: 0;
    max-width: none;
  }

  .agent-example a {
    font-weight: 600;
  }

  .agent-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .agent-links li {
    margin: 0;
  }

  .agent-links a {
    font-size: var(--text-secondary);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    width: fit-content;
  }

  .agent-links a:hover {
    color: oklch(0.78 0.12 185);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .agent-links a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .agent-links code {
    font-family: ui-monospace, "Cascadia Code", "Source Code Pro", monospace;
    font-size: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
  }
</style>
